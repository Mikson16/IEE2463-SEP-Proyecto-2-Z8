#ifndef STATES_H
#define STATES_H

#include <stdint.h>
#include <stdbool.h>
#include "zybomon.h"

// Estados del juego
typedef enum
{
    ST_SETUP = 0,
    ST_BV,
    ST_BV_MENU,
    ST_AT_MENU,
    ST_ZYB_MENU,
	ST_ZYB_SUB,
	ST_INS,
	ST_END_TURN,
	ST_CALCULATION,
	ST_T1_SWAP,
	ST_T2_SWAP,
	ST_T1_ATTACK,
	ST_T2_ATTACK,
	ST_T1_FAINT,
	ST_T2_FAINT,
	ST_NEW_TURN,
	ST_WIN,
	ST_LOSE

