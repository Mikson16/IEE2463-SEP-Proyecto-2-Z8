unsigned main_song_sample = 0;

u32 SdStartSong(TCHAR *filename)
{   FRESULT rc;

    FIL fil;

    u8 DataSizeBuff[4];
    u32 DataSize;


	rc = f_open (&Rfp, filename, FA_READ);

	if(rc != FR_OK)
		    {
		        xil_printf("ERROR : f_mount returned %d\r\n",rc);
		        return XST_FAILURE;
		    }

	rc = f_lseek (&Rfp, 40);

	if(rc != FR_OK)
			    {
			        xil_printf("ERROR : f_mount returned %d\r\n",rc);
			        return XST_FAILURE;
			    }

	rc = f_read (&Rfp, &DataSizeBuff, (UINT)4, &br);

	if(rc != FR_OK)
				    {
				        xil_printf("ERROR : f_mount returned %d\r\n",rc);
				        return XST_FAILURE;
				    }
	DataSize = (DataSizeBuff[0]) | (DataSizeBuff[1] << 8) | (DataSizeBuff[2] << 16) | (DataSizeBuff[3] << 24);
    CurrentByte = 44;

//	xil_printf("%c %c", ReadBuffer[0], ReadBuffer[1]);
	return DataSize;
}

u16 PlaySong()
{
	FRESULT rc;
	u8 ReadBuffer[2];
	int16_t sample;
	u16 pos_sample;
	if(CurrentByte >= SongSize + 44){
		CurrentByte = 44;
	}
	rc = f_lseek (&Rfp, CurrentByte);

	rc = f_read (&Rfp, &ReadBuffer, (UINT)2, &br);

	CurrentByte += 2;
	sample  = (ReadBuffer[0]) | (ReadBuffer[1] << 8);
//	pos_sample = abs(sample);
//	if(sample[15] = 0b1){
//		pos_sample = pos_sample + 3276
//	}
	pos_sample = sample + 32768;
//	xil_printf("muestra es: %d\n\r", pos_sample);
	return pos_sample;

}
