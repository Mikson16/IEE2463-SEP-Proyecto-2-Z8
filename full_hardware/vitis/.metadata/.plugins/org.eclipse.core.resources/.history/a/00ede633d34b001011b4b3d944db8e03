{
	int address_sum = 0;
	POINT x, y;
	int pixel;
	for(y = 0; y < 128; y ++ ) {
				for(x = 0; x < 128; x ++ ) {
					pixel = BitMapPtr->map[x][y];
					 Xil_Out32(SHARED_MEMORY_BASE + address_sum, pixel);
					 address_sum ++;

					}
				}
