<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="2_core"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
2_core
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="2_core">
        <sdx:configuration sdx:name="2_core"
                           sdx:displayName="2_core"
                           sdx:defaultProcessorGroup="graphics_core"
                           sdx:runtimes="cpp">
            <sdx:description>2_core</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="2_core/boot/2_core.bif"
                            sdx:readme="2_core/boot/generic.readme"
                            sdx:qemuArguments="2_core/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="2_core/boot/2_core.bif"
                            sdx:readme="2_core/boot/generic.readme"
                            sdx:qemuArguments="2_core/standalone_domain/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="graphics_core"
                            sdx:bif="2_core/boot/2_core.bif"
                            sdx:readme="2_core/boot/generic.readme"
                            sdx:qemuArguments="2_core/graphics_core/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on ps7_cortexa9_1"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_1">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="2_core/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="2_core/standalone_domain/bspinclude/include"
                        sdx:bspConfig="2_core/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
            <sdx:processorGroup sdx:name="graphics_core"
                                sdx:displayName="graphics_core"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="2_core/graphics_core/bsplib/lib"
                        sdx:bspIncludePaths="2_core/graphics_core/bspinclude/include"
                        sdx:bspConfig="2_core/graphics_core/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
