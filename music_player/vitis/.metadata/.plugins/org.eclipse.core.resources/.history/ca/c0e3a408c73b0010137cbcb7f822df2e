/***************** Function Definition ********************/
void TmrCtrIntrExample(XTmrCtr *TmrCtrInstancePtr,
			           u16      DeviceId,
			           u16      IntrId,
			           u8       TmrCtrNumber)
{
	XTmrCtr_Initialize(TmrCtrInstancePtr, DeviceId); // initialization of TIMER

	TmrCtrSetupIntrSystem(TmrCtrInstancePtr,    // of the interrupt system
					      DeviceId,
					      IntrId,
					      TmrCtrNumber);

	XTmrCtr_SetHandler(TmrCtrInstancePtr, TimerCounterHandler, TmrCtrInstancePtr);

	XTmrCtr_SetOptions(TmrCtrInstancePtr, TmrCtrNumber, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);

	XTmrCtr_SetResetValue(TmrCtrInstancePtr, TmrCtrNumber, RESET_VALUE);

	XTmrCtr_Start(TmrCtrInstancePtr, TmrCtrNumber);
}


/***********************************************************/
void TimerCounterHandler(void *CallBackRef, u8 TmrCtrNumber)
{
	// each time and interrupt is generated this is executed

		XGpio_DiscreteWrite(&GPIO, 1, leds);
		leds = ~leds;
		XGpio_DiscreteWrite(&GPIO, 2, 0);
		XTmrCtr_Reset(&TimerCounterInst, 0); // Reseteo del Timer
//		XTmrCtr_Start(&TimerCounterInst, 0);
}

/***********************************************************/
void TmrCtrSetupIntrSystem(XTmrCtr *TmrCtrInstancePtr,
				           u16      DeviceId,
				           u16      IntrId,
				           u8       TmrCtrNumber)
{
	XScuGic_Config *IntcConfig;

	IntcConfig = XScuGic_LookupConfig(INTC_DEVICE_ID);

	s32 status;

	status =  XScuGic_CfgInitialize(&IntcInstance, IntcConfig,
			IntcConfig -> CpuBaseAddress);

    if(status != XST_SUCCESS){
    	return -1;
    }

    XScuGic_SetPriorityTriggerType(&IntcInstance, TMRCTR_INTERRUPT_ID,
    					3, 0x01);

    status = XScuGic_Connect(&IntcInstance, TMRCTR_INTERRUPT_ID,
    		(Xil_ExceptionHandler)TimerCounterHandler, (void *)TmrCtrInstancePtr);


//	XIntc_Initialize(IntcInstancePtr, INTC_DEVICE_ID);
//
//	status = XIntc_Connect(IntcInstancePtr, IntrId,
//				 (XInterruptHandler)XTmrCtr_InterruptHandler,
//				 (void *)TmrCtrInstancePtr);

	if(status != XST_SUCCESS){
	    	return -1;
	    }

	XScuGic_Enable(&IntcInstance, TMRCTR_INTERRUPT_ID);

	// connect gic to processor

	Xil_ExceptionInit();// initialization of Xilinx exceptions subsystem
    // necessary before registering our Interrupt Handler

	Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
						            (Xil_ExceptionHandler)XScuGic_InterruptHandler,
						             (void *)&IntcInstance);
	Xil_ExceptionEnable();
} // enables exception management

