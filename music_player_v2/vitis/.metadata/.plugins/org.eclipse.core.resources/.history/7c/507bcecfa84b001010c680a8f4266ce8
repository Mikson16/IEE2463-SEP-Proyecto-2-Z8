unsigned main_song_sample = 0;

void SdStartSong(TCHAR *filename, FIL *RfPtr, u32 *CurrentBytePtr, u32 *AudioPlayerStatePtr)
{
	FRESULT rc;

    u8 DataSizeBuff[4];


	rc = f_open ((FIL *)RfPtr, filename, FA_READ);

	if(rc != FR_OK)
		    {
		        xil_printf("ERROR : f_open returned %d\r\n",rc);
		        return XST_FAILURE;
		    }

	rc = f_lseek ((FIL *)RfPtr, 40);

	if(rc != FR_OK)
			    {
			        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
			        return XST_FAILURE;
			    }

	rc = f_read ((FIL *)RfPtr, &DataSizeBuff, (UINT)4, &br);

	if(rc != FR_OK)
				    {
				        xil_printf("ERROR : f_read returned %d\r\n",rc);
				        return XST_FAILURE;
				    }

	// El conjunto de bytes esta en little endian, por lo que se concatenan al reves
	AudioSize = (DataSizeBuff[0]) | (DataSizeBuff[1] << 8) | (DataSizeBuff[2] << 16) | (DataSizeBuff[3] << 24);

	// Las muestras de la cancion en archivos .wav empiezan a partir del byte 44
	*CurrentBytePtr = 44;

    Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 20);

    *AudioPlayerStatePtr = 1;

}

void PlaySong(FIL *RfPtr, u32 *CurrentBytePtr)
{
	FRESULT rc;
	u8 ReadBuffer[4];
	int32_t sample;



	rc = f_lseek ((FIL *)RfPtr, *CurrentBytePtr);

	if(rc != FR_OK)
					    {
					        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
					        return XST_FAILURE;
					    }


	rc = f_read ((FIL *)RfPtr, &ReadBuffer, (UINT)4, &br);

	if(rc != FR_OK)
					    {
					        xil_printf("ERROR : f_read returned %d\r\n",rc);
					        return XST_FAILURE;
					    }

	*CurrentBytePtr += 4;

	sample  = (ReadBuffer[0] << 24) | (ReadBuffer[1] << 16) | (ReadBuffer[2] << 8) | ReadBuffer[3];

	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR, sample);

//    xil_printf("sample %d\r\n");


}
void SdStopSong(FIL *RfPtr)
{
	FRESULT rc;
	rc = f_close ((FIL *)RfPtr);

	if(rc != FR_OK)
			{
				xil_printf("ERROR : f_close returned %d\r\n",rc);
				return XST_FAILURE;
			}
	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 0);
	AudioPlayerState = 0;
}
void SdChangeSong(TCHAR *filename, FIL *RfPtr, u32 *CurrentBytePtr, u32 *AudioPlayerStatePtr)
{
	FRESULT rc;
	if(*AudioPlayerStatePtr != 0){
		rc = f_close ((FIL *)RfPtr);

		if(rc != FR_OK)
				{
					xil_printf("ERROR : f_close returned %d\r\n",rc);
					return XST_FAILURE;
				}
		}
	SdStartSong((TCHAR *) filename);

