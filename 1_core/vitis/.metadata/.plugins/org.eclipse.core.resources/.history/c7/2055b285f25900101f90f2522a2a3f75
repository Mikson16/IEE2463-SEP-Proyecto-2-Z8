/*Configuracion de interrupciones*/
int InterruptSetUp(XTmrCtr *InputTmrInstancePtr, XTmrCtr *AudioTmrInstancePtr, XGpio *LightGpioInstancePtr, XGpio *BtnGpioInstancePtr)
{
	XScuGic_Config *IntcConfig;

	IntcConfig = XScuGic_LookupConfig(INTC_DEVICE_ID);

	s32 status;

	status =  XScuGic_CfgInitialize(&IntcInstance, IntcConfig,
			IntcConfig -> CpuBaseAddress);

	if(status != XST_SUCCESS){
		return -1;
	}

	XGpio_InterruptEnable(&gpioLight, LIGHT_INT_CH);
	XGpio_InterruptGlobalEnable(&gpioLight);

	XGpio_InterruptEnable(&gpioBtn, BTN_INT_CH);
	XGpio_InterruptGlobalEnable(&gpioBtn);

	Xil_ExceptionInit();

	Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,(Xil_ExceptionHandler)XScuGic_InterruptHandler, &IntcInstance);
	Xil_ExceptionEnable();


	XTmrCtr_SetHandler(&InputTimerInst, (XTmrCtr_Handler)readInputs, &InputTimerInst);
	XTmrCtr_SetResetValue(&InputTimerInst, TIMER_CNTR_INPUT, INPUT_RESET_VALUE);
	XTmrCtr_SetOptions(&InputTimerInst, TIMER_CNTR_INPUT, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);

	XTmrCtr_SetHandler(&AudioTimerInst, (XTmrCtr_Handler)AudioTimerHandler, &AudioTimerInst);
	XTmrCtr_SetResetValue(&AudioTimerInst, TIMER_CNTR_AUDIO, AUDIO_RESET_VALUE);
	XTmrCtr_SetOptions(&AudioTimerInst, TIMER_CNTR_AUDIO, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);


	//Orden de prioridades

	XScuGic_SetPriorityTriggerType(&IntcInstance, GPIO_BTN_INTERRUPT_ID,
				 0x18, 0x03);
	XScuGic_SetPriorityTriggerType(&IntcInstance, GPIO_LIGHT_INTERRUPT_ID,
				 0x20, 0x03);
	XScuGic_SetPriorityTriggerType(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID,
				 0x28, 0x01);
	XScuGic_SetPriorityTriggerType(&IntcInstance, INPUT_TMRCTR_INTERRUPT_ID,
				 0x30, 0x01); //Timer de inputs y pantalla con menor prioridad


	status = XScuGic_Connect(&IntcInstance, INPUT_TMRCTR_INTERRUPT_ID,
				(Xil_ExceptionHandler)readInputs, (void *) InputTmrInstancePtr);

	if(status != XST_SUCCESS){
			return -1;
		}

	status = XScuGic_Connect(&IntcInstance, GPIO_LIGHT_INTERRUPT_ID,
				(Xil_ExceptionHandler)lightHandler, (void *) LightGpioInstancePtr);

	if(status != XST_SUCCESS){
			return -1;
		}

	status = XScuGic_Connect(&IntcInstance, GPIO_BTN_INTERRUPT_ID,
				(Xil_ExceptionHandler)btnHandler, (void *) BtnGpioInstancePtr);

	if(status != XST_SUCCESS){
			return -1;
		}

	status = XScuGic_Connect(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID,
				(Xil_ExceptionHandler)AudioTimerHandler, (void *) AudioTmrInstancePtr);


	if(status != XST_SUCCESS){
			return -1;
		}


	return 0;
}

void disableInterrupts()
{
	XScuGic_Disable(&IntcInstance, INPUT_TMRCTR_INTERRUPT_ID);
	XScuGic_Disable(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID);
	XScuGic_Disable(&IntcInstance, GPIO_LIGHT_INTERRUPT_ID);
	XScuGic_Disable(&IntcInstance, GPIO_BTN_INTERRUPT_ID);
	XTmrCtr_Stop(&InputTimerInst, TIMER_CNTR_INPUT);
	XTmrCtr_Stop(&AudioTimerInst, TIMER_CNTR_AUDIO);
}

void enableInterrupts()
{
	XScuGic_Enable(&IntcInstance, INPUT_TMRCTR_INTERRUPT_ID);
	XScuGic_Enable(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID);
	XScuGic_Enable(&IntcInstance, GPIO_LIGHT_INTERRUPT_ID);
	XScuGic_Enable(&IntcInstance, GPIO_BTN_INTERRUPT_ID);
	XTmrCtr_Reset(&InputTimerInst, TIMER_CNTR_INPUT);
	XTmrCtr_Reset(&AudioTimerInst, TIMER_CNTR_AUDIO);
	XTmrCtr_Start(&InputTimerInst, TIMER_CNTR_INPUT);
	XTmrCtr_Start(&AudioTimerInst, TIMER_CNTR_AUDIO);
}

/*Manejo de interrupcion de inputs y pantalla */
void readInputs(void *CallBackRef)
{
	//Se corrobora que el timer termino
	if (XTmrCtr_IsExpired(&InputTimerInst, TIMER_CNTR_INPUT)){
	XTmrCtr_Stop(&InputTimerInst, TIMER_CNTR_INPUT);

	read_opt();

	//Manejo del codigo en loop del estado actual
	StateHandler();

	//Manejo de la lectura del joystick
	JoyHandler(read_joyx(), read_joyy());

	//Manejo de la lectura del acelerometro
	if(peek(&state_stack) < ST_WIN){
		int new_tilt = read_acx();

		AccHandler(new_tilt);
		tiltx = new_tilt;
	}


	//Manejo del microfono
	int mic_amp = read_MIC();
	if(AudioPlayerState != 2){
		mic_amp -= 256;
		if(abs(mic_amp) > 70){
			AudioSize = SdSoundEffect("PIKA.wav", &Rfp, &CurrentByte, &AudioPlayerState);
		}
	}

	//Ajuste de volumen
	volume = read_POT1()*2/ (float) 256;
	//xil_printf("Volumen :%.2f\n", volume);

	//Sincronizacion y comunicacion con el otro nucleo del procesador
//	if(CORE_FLAG == 0){
//		Send_Bitmap(&new_bitmap);
//		CORE_FLAG = 1;
//	}

	GUI_Update_Bitmap(&prev_bitmap, &new_bitmap);
	prev_bitmap = new_bitmap;

	XTmrCtr_Reset(&InputTimerInst, TIMER_CNTR_INPUT);
	XTmrCtr_Start(&InputTimerInst, TIMER_CNTR_INPUT);
	}
}

//Manejo del audio
void AudioTimerHandler(void *CallBackRef)
{

	if (XTmrCtr_IsExpired(&AudioTimerInst, TIMER_CNTR_AUDIO)){
	    XTmrCtr_Stop(&AudioTimerInst, TIMER_CNTR_AUDIO);


	    if(AudioPlayerState == STOP){
	    	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR, 0);
	    }
	    //La musica de batalla se reproduce en bucle
	    else if(AudioPlayerState == MUSIC){
	    	if(CurrentByte + 4 >= AudioSize + 44){
				CurrentByte = 44; //Byte donde inician las muestras de audio
	    		}
	    	//Se leen muestras de audio y se envian al AXI BUZZER
			PlaySong(&Rfp, &CurrentByte, volume);
			SongCurrentByte = CurrentByte;

	    }
	    //Una vez termina un efecto de sonido se resume la musica de batalla
	    else if(AudioPlayerState == SOUND_EFFECT){
	    	if(CurrentByte + 4 >= AudioSize + 44){
	    		AudioFile = SongFile[SongIndex];
	    		AudioSize = SdResumeSong(AudioFile, &Rfp, &CurrentByte, &AudioPlayerState);
				CurrentByte = SongCurrentByte;
				}
	    	else{
	    		PlaySong(&Rfp, &CurrentByte, volume);
	    	}
	    }


		XTmrCtr_Reset(&AudioTimerInst, TIMER_CNTR_AUDIO);
		XTmrCtr_Start(&AudioTimerInst, TIMER_CNTR_AUDIO);
	}

}

/*Manejo de interrupcion del sensor de luz*/
void lightHandler(void *CallBackRef)
{
	XGpio_InterruptDisable(&gpioLight, LIGHT_INT_CH);
	float light;
	light = read_opt();

	//Si la luz es menor a 50 se activa el modo oscuro
	if(light < 50){
		text_color = WHITE;
		light_mode = 1;
	}
	//De lo contrario se activa el modo claro
	else{
		text_color = BLACK;
		light_mode = 0;
	}
	//Se recargan los sprites
	LoadStateSprites(peek(&state_stack));
	XGpio_InterruptClear(&gpioLight, LIGHT_INT_CH);
	XGpio_InterruptEnable(&gpioLight, LIGHT_INT_CH);

}
/*Manejo de interrupciones de los botones */
void btnHandler(void *CallBackRef)
{
	XGpio_InterruptDisable(&gpioBtn, BTN_INT_CH);
	u8 btns;

	//Se leen los 3 botones concatenados
	btns = XGpio_DiscreteRead(&gpioBtn, BTN_INT_CH);

	//Boton del joystick
	if(btns >= 4){
		//no hace nada
	}
	//Boton inferior
	else if(btns >= 2){
		if(peek(&state_stack) > ST_BV && peek(&state_stack) <= ST_INS){
			//Retrocede de estado
			back_state();
		}

	}
	//Boton superior
	else if(btns >= 1){
		//Avanza de estado
		advance_state();
	}
	(void)XGpio_InterruptClear(&gpioBtn, BTN_INT_CH);
	XGpio_InterruptEnable(&gpioBtn, BTN_INT_CH);
}

