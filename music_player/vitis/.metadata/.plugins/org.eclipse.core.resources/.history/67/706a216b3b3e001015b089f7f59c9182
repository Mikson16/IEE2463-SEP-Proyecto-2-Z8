TCHAR *path = "0:/";
void SdReaderSetup()
{
	FRESULT rc;
	rc = f_mount (&fs, path, 0);
	if(rc != FR_OK)
	    {
	        xil_printf("ERROR : f_mount returned %d\r\n",rc);
	        return XST_FAILURE;
	    }
}

/***********************************************************/
unsigned main_song_sample = 0;

u32 SdStartSong(TCHAR *filename)
{   FRESULT rc;

    u8 DataSizeBuff[4];
    u32 DataSize;


	rc = f_open (&Rfp, filename, FA_READ);

	if(rc != FR_OK)
		    {
		        xil_printf("ERROR : f_mount returned %d\r\n",rc);
		        return XST_FAILURE;
		    }

	rc = f_lseek (&Rfp, 40);

	if(rc != FR_OK)
			    {
			        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
			        return XST_FAILURE;
			    }

	rc = f_read (&Rfp, &DataSizeBuff, (UINT)4, &br);

	if(rc != FR_OK)
				    {
				        xil_printf("ERROR : f_read returned %d\r\n",rc);
				        return XST_FAILURE;
				    }

	// El conjunto de bytes esta en little endian, por lo que se concatenan al reves
	DataSize = (DataSizeBuff[0]) | (DataSizeBuff[1] << 8) | (DataSizeBuff[2] << 16) | (DataSizeBuff[3] << 24);

	// Las muestras de la cancion en archivos .wav empiezan a partir del byte 44
    CurrentByte = 44;

	return DataSize;
}

u16 PlaySong()
{
	FRESULT rc;
	u8 ReadBuffer[1];
	int16_t signed_sample;
	u8 unsigned_sample;

	if(CurrentByte >= SongSize + 44){
		CurrentByte = 44;
	}

	rc = f_lseek (&Rfp, CurrentByte);

	if(rc != FR_OK)
					    {
					        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
					        return XST_FAILURE;
					    }

	rc = f_read (&Rfp, &ReadBuffer, (UINT)1, &br);

	if(rc != FR_OK)
					    {
					        xil_printf("ERROR : f_read returned %d\r\n",rc);
					        return XST_FAILURE;
					    }

	CurrentByte += 1;

	//
	sample  = ReadBuffer[0];
	unsigned_sample = sample + 256;

	return unsigned_sample;

}
