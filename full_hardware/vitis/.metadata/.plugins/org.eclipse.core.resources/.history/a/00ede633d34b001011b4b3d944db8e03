//			return XST_FAILURE;
		}

	// El conjunto de bytes esta en little endian, por lo que se concatenan al reves
	FileSize = (SizeBuff[0]) | (SizeBuff[1] << 8) | (SizeBuff[2] << 16) | (SizeBuff[3] << 24);


	u32 DataSize;

	rc = f_lseek (&Rfp, 0x0A);

