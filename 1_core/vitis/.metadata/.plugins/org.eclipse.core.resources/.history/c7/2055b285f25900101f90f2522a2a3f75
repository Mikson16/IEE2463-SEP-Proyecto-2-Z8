/*Funcion que abre los sprites*/
void SdOpenSprite(TCHAR *filename, BITMAP *SpritePtr){

	//Detiene el timer y la interrupcion de audio
	//Ya que necesita usar la tarjeta SD
	XTmrCtr_Stop(&AudioTimerInst, TIMER_CNTR_AUDIO);
	XScuGic_Disable(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID);

	FRESULT rc;

	//Cierra el archivo de audio si hay reproduccion
	if(AudioPlayerState != STOP){
		rc = f_close(&Rfp);

		if(rc != FR_OK)
		{
			xil_printf("ERROR 1: f_close returned %d\r\n",rc);
//			return XST_FAILURE;
		}
	}
	//Abre el sprite y lo guarda en el BITMAP
	Open_Sprite((TCHAR *)filename, (BITMAP *)SpritePtr);

	//Vuelve a abrir el archivo de audio
	rc = f_open(&Rfp, AudioFile, FA_READ);

	if(rc != FR_OK)
			{
				xil_printf("ERROR 1: f_open returned %d\r\n",rc);
	//			return XST_FAILURE;
			}

	//restablece el timer y la interrupcion de audio
	XScuGic_Enable(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID);
	XTmrCtr_Reset(&AudioTimerInst, TIMER_CNTR_AUDIO);
	XTmrCtr_Start(&AudioTimerInst, TIMER_CNTR_AUDIO);

}
