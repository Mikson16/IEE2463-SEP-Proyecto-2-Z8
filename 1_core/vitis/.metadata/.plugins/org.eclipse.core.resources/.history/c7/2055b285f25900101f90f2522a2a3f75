/*Avanza al siguiente estado del juego */
void advance_state()
{
	if(peek(&state_stack) == ST_SETUP){
		push(&state_stack, ST_BV);
		LoadStateSprites(ST_BV);
	}
	else if(peek(&state_stack) == ST_BV){
		push(&state_stack, ST_BV_MENU);
		push(&Xselection_stack, select_x);
		push(&Yselection_stack, select_y);
		LoadStateSprites(ST_BV_MENU);
	}
	else if(peek(&state_stack) == ST_BV_MENU){
		if(select_x == 0){
			push(&state_stack, ST_AT_MENU);
			push(&Xselection_stack, select_x);
			push(&Yselection_stack, select_y);
			LoadStateSprites(ST_AT_MENU);
		}
		else if(select_x == 1){
			push(&state_stack, ST_ZYB_MENU);
			push(&Xselection_stack, select_x);
			push(&Yselection_stack, select_y);
			LoadStateSprites(ST_ZYB_MENU);
		}

	}
	else if(peek(&state_stack) == ST_AT_MENU){
		int selection = select_x + select_y *2;

		//Verificar que le quedan usos al ataque seleccionado
		if(trainer1.zybomons[0].attacks[selection].uses > 0){
			player_choice.action = ATTACK_ACTION;
			player_choice.target = selection;
			push(&state_stack, ST_END_TURN);
			push(&Xselection_stack, select_x);
			push(&Yselection_stack, select_y);
			LoadStateSprites(ST_BV);
		}

	}
	else if(peek(&state_stack) == ST_ZYB_MENU){
		push(&state_stack, ST_ZYB_SUB);
		push(&Xselection_stack, select_x);
		push(&Yselection_stack, select_y);
		LoadStateSprites(ST_ZYB_SUB);
	}
	else if(peek(&state_stack) == ST_ZYB_SUB){
		//Verificar que el zybomon a cambiar tenga vida restante y que no sea el que ya esta activo
		if(select_x == 0 && trainer1.zybomons[peek(&Yselection_stack)].lp > 0 && peek(&Yselection_stack) != 0){
			player_choice.action = SWAP_ACTION;
			player_choice.target = peek(&Yselection_stack);
			push(&state_stack, ST_END_TURN);
			push(&Xselection_stack, select_x);
			push(&Yselection_stack, select_y);
			LoadStateSprites(ST_BV);
		}
		if(select_x == 1){
			push(&state_stack, ST_INS);
			push(&Xselection_stack, select_x);
			select_x = peek(&Yselection_stack);
			push(&Yselection_stack, select_y);
			select_y = 0;
			LoadStateSprites(ST_INS);
		}
	}
	else if(peek(&state_stack) == ST_END_TURN){
		init_stack(&action_stack);

		push(&Xselection_stack, select_x);
		push(&Yselection_stack, select_y);

		//Se determina las acciones del cpu
		cpu_choice = auto_trainer_battle(&trainer2, &trainer1);

		//Se cargan los estados que ocurriran segun las acciones elegidas por cpu y jugador
		load_turn_action(&action_stack, &trainer1, &trainer2, player_choice, cpu_choice);

		load_animations(&player_animation, &cpu_animation, &trainer1, &trainer2, player_choice, cpu_choice);

		push(&state_stack, pop(&action_stack));
		LoadStateSprites(ST_BV);
	}
	else if(peek(&state_stack) == ST_T1_SWAP){
		push(&state_stack, pop(&action_stack));
		LoadStateSprites(ST_BV);
	}
	else if(peek(&state_stack) == ST_T2_SWAP){
		push(&state_stack, pop(&action_stack));
		LoadStateSprites(ST_BV);
	}
	else if(peek(&state_stack) == ST_T1_ATTACK){
		if(trainer2.zybomons[0].lp > 0){
			push(&state_stack, pop(&action_stack));
		}
		else{
			push(&state_stack, ST_T2_FAINT);
		}
		LoadStateSprites(ST_BV);
	}
	else if(peek(&state_stack) == ST_T2_ATTACK){
		if(trainer1.zybomons[0].lp > 0){
			push(&state_stack, pop(&action_stack));
		}
		else{
			push(&state_stack, ST_T1_FAINT);
		}
		LoadStateSprites(ST_BV);
	}
	else if(peek(&state_stack) == ST_T1_FAINT){
		int remaining = handle_faint(&trainer1);
		if(remaining){
			push(&state_stack, ST_NEW_TURN);
		}
		else{
			push(&state_stack, ST_LOSE);
			SdOpenSprite("LOSE.BMP", &background_sprite);
			AudioFile = "LOSE.wav";
			AudioSize = SdChangeSong(AudioFile, &Rfp, &CurrentByte, &AudioPlayerState);
		}
	}
	else if(peek(&state_stack) == ST_T2_FAINT){
		int remaining = handle_faint(&trainer2);
		if(remaining){
			push(&state_stack, ST_NEW_TURN);
		}
		else{
			push(&state_stack, ST_WIN);
			SdOpenSprite("WIN.BMP", &background_sprite);
			AudioFile = "WIN.wav";
			AudioSize = SdChangeSong(AudioFile, &Rfp, &CurrentByte, &AudioPlayerState);
		}
	}
	else if(peek(&state_stack) == ST_NEW_TURN){
		init_stack(&state_stack);
		init_stack(&Yselection_stack);
		init_stack(&Xselection_stack);
		push(&state_stack, ST_BV);
		LoadStateSprites(ST_BV);
	}
	xil_printf("%d\n",peek(&state_stack));
}

//retroceder estado
void back_state()
{
	pop(&state_stack);
	select_x = pop(&Xselection_stack);
	select_y = pop(&Yselection_stack);
	LoadStateSprites(peek(&state_stack));
}

//Loop ejecutado en cada estado
void StateHandler()
{
	if(peek(&state_stack)== ST_SETUP){
		advance_state();

	}
	else if(peek(&state_stack)== ST_BV){
		ShowBattleView(&new_bitmap);
		Xoptions = 1;
		Yoptions = 1;
	}
	else if(peek(&state_stack) == ST_BV_MENU){
		ShowBattleViewMenu(&new_bitmap);
		Xoptions = 2;
		Yoptions = 1;
	}
	else if(peek(&state_stack) == ST_AT_MENU){
		ShowAttackMenu(&new_bitmap);
		Xoptions = 2;
		Yoptions = 2;
		}
	else if(peek(&state_stack) == ST_ZYB_MENU){
		ShowZybomonMenu(&new_bitmap, select_y);
		Xoptions = 1;
		Yoptions = 4;
		}
	else if(peek(&state_stack) == ST_ZYB_SUB){
		ShowZybomonSubMenu(&new_bitmap, select_x);
		Xoptions = 2;
		Yoptions = 1;
		}
	else if(peek(&state_stack) == ST_INS){
		ShowInsMenu(&new_bitmap, select_x, select_y);
		Xoptions = 4;
		Yoptions = 5;
	}
	else if(peek(&state_stack) == ST_END_TURN){
		ShowBattleView(&new_bitmap);
		Xoptions = 1;
		Yoptions = 1;

		advance_state();
	}
	else if(peek(&state_stack) == ST_T1_SWAP){
		result = playPlayerSwapAnimation(&player_animation, &new_bitmap);
		if(result){
			handle_swap(&trainer1, player_choice.target);
			advance_state();
		}

	}
	else if(peek(&state_stack) == ST_T2_SWAP){
		ShowBattleView(&new_bitmap);
		handle_swap(&trainer2, cpu_choice.target);
		advance_state();
	}
	else if(peek(&state_stack) == ST_T1_ATTACK){
		ShowBattleView(&new_bitmap);
		handle_attack(&trainer1, &trainer2, player_choice.target);
		advance_state();
	}
	else if(peek(&state_stack) == ST_T2_ATTACK){
		ShowBattleView(&new_bitmap);
		handle_attack(&trainer2, &trainer1, cpu_choice.target);
		advance_state();
	}
	else if(peek(&state_stack) == ST_T1_FAINT){
		ShowBattleView(&new_bitmap);

		advance_state();
	}
	else if(peek(&state_stack) == ST_T2_FAINT){
		ShowBattleView(&new_bitmap);

		advance_state();
	}
	else if(peek(&state_stack) == ST_NEW_TURN){
		advance_state();
	}
	else if(peek(&state_stack) == ST_LOSE){

		Paint_Sprite(0, 0, &new_bitmap, &background_sprite);
	}
	else if(peek(&state_stack) == ST_WIN){

		Paint_Sprite(0, 0, &new_bitmap, &background_sprite);
	}
}

//Manejo del accelerometro cambia la musica de batalla
void AccHandler(int new_tilt)
{
	if(new_tilt >= 256 + 56 && tiltx < 256 + 56){
		if(SongIndex < 1){
			SongIndex += 1;
			AudioFile = SongFile[SongIndex];
			AudioSize = SdChangeSong(AudioFile, &Rfp, &CurrentByte, &AudioPlayerState);
		}
	}
	else if(new_tilt <= 256 - 56 && tiltx > 256 - 56){
		if(SongIndex > 0){
			SongIndex -= 1;
			AudioFile = SongFile[SongIndex];
			AudioSize = SdChangeSong(AudioFile, &Rfp, &CurrentByte, &AudioPlayerState);
		}
	}

}

/*Manejo del joystick*/
void JoyHandler(int joyx,int joyy)
{
	if(joyx > 340) {
		movex = 1;
	}
	else if(joyx < 200) {
		movex = -1;
	}
	else{
		movex = 0;
	}
	if(joyy > 340) {
		movey = -1;
	}
	else if(joyy < 172) {
		movey = 1;
	}
	else{
		movey = 0;
	}

	if(movex != movex_prev){
		refractx = 0;
		select_x = select_x + movex;
	}
	else{
	if(refractx == ref_time){ //Si se mantiene una direccion despues de un ciclo el periodo refractario disminuye a la mitad
		refractx = ref_time/2;
		select_x = select_x + movex;
	}
	else{
		refractx ++;
	}
}

	if(movey != movey_prev){
		refracty = 0;
		select_y = select_y + movey;
	}
	else{
		if(refracty == ref_time){ //Si se mantiene una direccion despues de un ciclo el periodo refractario disminuye a la mitad
			refracty = ref_time/2;
			select_y = select_y + movey;
		}
		else{
			refracty ++;
		}
	}

	movex_prev = movex;
	movey_prev = movey;

	if(select_x > Xoptions - 1){
		select_x = Xoptions - 1;
	}
	else if(select_x < 0){
		select_x = 0;
	}

	if(select_y > Yoptions - 1){
		select_y = Yoptions - 1;
	}
	else if(select_y < 0){
		select_y = 0;
	}


}

