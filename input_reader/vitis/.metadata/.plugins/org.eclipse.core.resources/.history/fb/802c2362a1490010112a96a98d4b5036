void JoyHandler(int joyx,int joyy)
{
	if(joyx > 340) {
		movex = 1;
	}
	else if(joyx < 200) {
		movex = -1;
	}
	else{
		movex = 0;
	}
	if(joyx > 340) {
		movey = 1;
	}
	else if(joyx < 172) {
		movey = -1;
	}
	else{
		movey = 0;
	}

	if(movex != movex_prev){
		refractx = 0;
	}
	else if(refractx < ref_time){
		refractx ++;
	}
	else if(refractx == ref_time){
		refractx = 0;
	}

	if(refractx = 0){
		pok_x = pox + movex*10;
	}

	if(movey != movey_prev){
		refracty = 0;
	}
	else if(refractx < ref_time){
		refracty ++;
	}
	else if(refractx == ref_time){
		refracty = 0;
	}

	if(refracty = 0){
		pok_y = poy + movey*10;
	}

	movex_prev = movex;
	movey_prev = movey;


}

