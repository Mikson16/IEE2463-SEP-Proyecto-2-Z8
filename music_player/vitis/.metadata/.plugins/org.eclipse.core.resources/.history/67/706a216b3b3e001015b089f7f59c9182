/***************** Macros ********************************/
#define TMRCTR_DEVICE_ID	XPAR_TMRCTR_0_DEVICE_ID
#define TMRCTR_INTERRUPT_ID	XPAR_FABRIC_AXI_TIMER_0_INTERRUPT_INTR

#define INTC_DEVICE_ID		XPAR_PS7_SCUGIC_0_DEVICE_ID

#define TIMER_CNTR_0	    0
#define RESET_VALUE	        (2^32) - 12500// 8 kHz

/***************** Function declaration *******************/
void TmrCtrIntrExample(XTmrCtr *InstancePtr,
			           u16      DeviceId);

void TmrCtrSetupIntrSystem(XTmrCtr *InstancePtr,
				           u16      DeviceId);

void TimerCounterHandler(void *CallBackRef, u8 TmrCtrNumber);

void SdReaderSetup();

u32 SdStartSong(TCHAR *filename);

u16 PlaySong();

/***************** IPs Instantiation **********************/
XScuGic  IntcInstance;
XTmrCtr  TimerCounterInst;
XGpio    GPIO;

FATFS fs;
unsigned leds = 0b0000;
u32 SongSize;
u32 CurrentByte;
FIL Rfp;
UINT br;
/***************** Main ***********************************/
int main(void){

	XGpio_Initialize(&GPIO, XPAR_GPIO_0_DEVICE_ID); // initialization of GPIO


	SdReaderSetup();


	SongSize = SdStartSong("BATTLE.wav");

	TmrCtrIntrExample(&TimerCounterInst,
					      TMRCTR_DEVICE_ID);

}

/***************** Function Definition ********************/
void TmrCtrIntrExample(XTmrCtr *TmrCtrInstancePtr,
			           u16      DeviceId)
{
	XTmrCtr_Initialize(TmrCtrInstancePtr, DeviceId); // initialization of TIMER

	TmrCtrSetupIntrSystem(TmrCtrInstancePtr,    // of the interrupt system
					      DeviceId);


}


/***********************************************************/
void TimerCounterHandler(void *CallBackRef, u8 TmrCtrNumber)
{

	if (XTmrCtr_IsExpired(&TimerCounterInst,0)){

	    XTmrCtr_Stop(&TimerCounterInst, 0);

		XGpio_DiscreteWrite(&GPIO, 1, leds); //Parpadeo de Leds
		leds = ~leds;

		u16 SongSample;
		SongSample = PlaySong(); //Se lee la siguiente muestra del archivo de auido
		XGpio_DiscreteWrite(&GPIO, 2, SongSample); //Se envía al bloque PWM

		XTmrCtr_Reset(&TimerCounterInst, 0);
		XTmrCtr_Start(&TimerCounterInst, 0);
	}

}

/***********************************************************/
void TmrCtrSetupIntrSystem(XTmrCtr *TmrCtrInstancePtr,
				           u16      DeviceId)
{
	XScuGic_Config *IntcConfig;

	IntcConfig = XScuGic_LookupConfig(INTC_DEVICE_ID);

	s32 status;

	status =  XScuGic_CfgInitialize(&IntcInstance, IntcConfig,
			IntcConfig -> CpuBaseAddress);

    if(status != XST_SUCCESS){
    	return -1;
    }

    Xil_ExceptionInit();// initialization of Xilinx exceptions subsystem
        // necessary before registering our Interrupt Handler

    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
    						            (Xil_ExceptionHandler)XScuGic_InterruptHandler,
    						             &IntcInstance);
    Xil_ExceptionEnable();


    XTmrCtr_SetHandler(&TimerCounterInst, (XTmrCtr_Handler)TimerCounterHandler, &TimerCounterInst);
  	XTmrCtr_SetResetValue(&TimerCounterInst, TIMER_CNTR_0, RESET_VALUE);
  	XTmrCtr_SetOptions(&TimerCounterInst, TIMER_CNTR_0, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);
   	XTmrCtr_Start(&TimerCounterInst, TIMER_CNTR_0);

    XScuGic_SetPriorityTriggerType(&IntcInstance, TMRCTR_INTERRUPT_ID,
        		 0x18, 0x01);

    status = XScuGic_Connect(&IntcInstance, TMRCTR_INTERRUPT_ID,
        		(Xil_ExceptionHandler)TimerCounterHandler, (void *) TmrCtrInstancePtr);


	if(status != XST_SUCCESS){
	    	return -1;
	    }

	XScuGic_Enable(&IntcInstance, TMRCTR_INTERRUPT_ID);



} // enables exception management

