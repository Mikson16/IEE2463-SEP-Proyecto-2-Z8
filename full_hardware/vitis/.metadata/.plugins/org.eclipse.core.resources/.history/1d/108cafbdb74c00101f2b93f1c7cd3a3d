FATFS fs;

UINT br;



u32 SdStartSong(TCHAR *filename, FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc = FR_INVALID_NAME;

    u8 DataSizeBuff[4];
    u32 DataSize;

    while(rc != FR_OK){
	rc = f_open (RfPtr, filename, FA_READ);

	if(rc != FR_OK)
		    {
		        xil_printf("ERROR 2: f_open returned %d\r\n",rc);
//		        return XST_FAILURE;
		    }
    }
	rc = f_lseek ((FIL *)RfPtr, 40);

	if(rc != FR_OK)
			    {
			        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
			        return XST_FAILURE;
			    }

	rc = f_read ((FIL *)RfPtr, &DataSizeBuff, (UINT)4, &br);

	if(rc != FR_OK)
				    {
				        xil_printf("ERROR : f_read returned %d\r\n",rc);
				        return XST_FAILURE;
				    }

	// El conjunto de bytes esta en little endian, por lo que se concatenan al reves
	DataSize = (DataSizeBuff[0]) | (DataSizeBuff[1] << 8) | (DataSizeBuff[2] << 16) | (DataSizeBuff[3] << 24);

	// Las muestras de la cancion en archivos .wav empiezan a partir del byte 44
	*CurrentBytePtr = 44;

    Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 20);

    *AudioPlayerStatePtr = 1;

    return DataSize;

}

void PlaySong(FIL *RfPtr, u32 *CurrentBytePtr, float volume)
{
	FRESULT rc;
	u8 ReadBuffer[4];
	int32_t sample;

	u32 CurrentByte = *CurrentBytePtr;

	rc = f_lseek ((FIL *)RfPtr, CurrentByte);

	if(rc != FR_OK)
					    {
					        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
					        return XST_FAILURE;
					    }


	rc = f_read (RfPtr, &ReadBuffer, (UINT)4, &br);

	if(rc != FR_OK)
					    {
					        xil_printf("ERROR : f_read returned %d\r\n",rc);
					        return XST_FAILURE;
					    }

	*CurrentBytePtr += 4;

	int byte[4];

	int i;

	for(i = 0; i < 4; i ++ ){

	byte[i] = ReadBuffer[i];
	byte[i] = floor((byte[i] - 127)*volume);


	byte[i] = byte[i] + 127;

	if(byte[i] < 0){
		byte[i] = 0;
	}
	elsif(byte[i] >= 255){
		byte[i] = 255;
	}

//	byte[i] = floor(ReadBuffer[i]*volume);
//	byte2 = floor(ReadBuffer[1]*volume);
//	byte3 = floor(ReadBuffer[2]*volume);
//	byte4 = floor(ReadBuffer[3]*volume);
	}

	sample  = (byte[0] << 24) | (byte[1] << 16) | (byte[2] << 8) | byte[3];

	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR, sample);

//    xil_printf("sample %d\r\n", sample & 0x000000FF);


}
void SdStopSong(FIL *RfPtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;
	rc = f_close ((FIL *)RfPtr);

	if(rc != FR_OK)
			{
				xil_printf("ERROR : f_close returned %d\r\n",rc);
				return XST_FAILURE;
			}
	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 0);
	*AudioPlayerStatePtr = 0;
}

u32 SdChangeSong(TCHAR *filename, FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;
	if(*AudioPlayerStatePtr != 0){
		rc = f_close ((FIL *)RfPtr);

		if(rc != FR_OK)
				{
					xil_printf("ERROR : f_close returned %d\r\n",rc);
					return XST_FAILURE;
				}
		}

	return SdStartSong((TCHAR *) filename, (FIL *) RfPtr, (u32 *) CurrentBytePtr, (u8 *) AudioPlayerStatePtr);

}
u32 SdSoundEffect(TCHAR *filename,  FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;

	u8 DataSizeBuff[4];
	u32 DataSize;

	if(*AudioPlayerStatePtr != 0){
		rc = f_close ((FIL *)RfPtr);

		if(rc != FR_OK)
				{
					xil_printf("ERROR : f_close returned %d\r\n",rc);
					return XST_FAILURE;
				}
	}


	rc = f_open ((FIL *)RfPtr, filename, FA_READ);

	if(rc != FR_OK)
			{
				xil_printf("ERROR : f_open returned %d\r\n",rc);
				return XST_FAILURE;
			}

	rc = f_lseek ((FIL *)RfPtr, 40);

	if(rc != FR_OK)
				{
					xil_printf("ERROR : f_lseek returned %d\r\n",rc);
					return XST_FAILURE;
				}

	rc = f_read ((FIL *)RfPtr, &DataSizeBuff, (UINT)4, &br);

	if(rc != FR_OK)
					{
						xil_printf("ERROR : f_read returned %d\r\n",rc);
						return XST_FAILURE;
					}

	// El conjunto de bytes esta en little endian, por lo que se concatenan al reves
	DataSize = (DataSizeBuff[0]) | (DataSizeBuff[1] << 8) | (DataSizeBuff[2] << 16) | (DataSizeBuff[3] << 24);

	// Las muestras de la cancion en archivos .wav empiezan a partir del byte 44
	*CurrentBytePtr = 44;

	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 20);


	*AudioPlayerStatePtr = 2;

	return DataSize;

}
u32 SdResumeSong(TCHAR *filename,  FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;

	if(*AudioPlayerStatePtr != 0){
		rc = f_close ((FIL *)RfPtr);

		if(rc != FR_OK)
				{
					xil_printf("ERROR : f_close returned %d\r\n",rc);
					return XST_FAILURE;
				}
	}
	return SdStartSong((TCHAR *) filename, (FIL *) RfPtr, (u32 *) CurrentBytePtr, (u8 *) AudioPlayerStatePtr);

}
