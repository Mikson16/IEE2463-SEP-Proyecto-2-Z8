FATFS fs;
UINT br;


u32 SdStartSong(TCHAR *filename, FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc = FR_INVALID_NAME;

    u8 DataSizeBuff[4];
    u32 DataSize;

    //Se abre el archivo de musica
	rc = f_open (RfPtr, filename, FA_READ);

	if(rc != FR_OK)
		    {
		        xil_printf("ERROR 2: f_open returned %d\r\n",rc);
//		        return XST_FAILURE;
		    }

    //La cantidad de bytes de muestras de auido se guarda en el byte 40 del archivo .wav
	rc = f_lseek ((FIL *)RfPtr, 40);

	if(rc != FR_OK)
			    {
			        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
			        return XST_FAILURE;
			    }

	rc = f_read ((FIL *)RfPtr, &DataSizeBuff, (UINT)4, &br);

	if(rc != FR_OK)
				    {
				        xil_printf("ERROR : f_read returned %d\r\n",rc);
				        return XST_FAILURE;
				    }

	// El conjunto de bytes esta en little endian, por lo que se concatenan al reves
	DataSize = (DataSizeBuff[0]) | (DataSizeBuff[1] << 8) | (DataSizeBuff[2] << 16) | (DataSizeBuff[3] << 24);

	// Las muestras de la cancion en archivos .wav empiezan a partir del byte 44
	*CurrentBytePtr = 44;

    Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 5);


    *AudioPlayerStatePtr = MUSIC;

    return DataSize;

}

void PlaySong(FIL *RfPtr, u32 *CurrentBytePtr, float volume)
{
	FRESULT rc;
	u8 ReadBuffer[4];
	int32_t sample;

	u32 CurrentByte = *CurrentBytePtr;

	//Se busca la posicion actual de la cancion
	rc = f_lseek ((FIL *)RfPtr, CurrentByte);

	if(rc != FR_OK)
					    {
					        xil_printf("ERROR : f_lseek returned %d\r\n",rc);
					        return XST_FAILURE;
					    }

	int j;
	for(j = 1; j<4 ;j++){

		//Se leen 4 bytes
		rc = f_read (RfPtr, &ReadBuffer, (UINT)4, &br);

		if(rc != FR_OK)
							{
								xil_printf("ERROR : f_read returned %d\r\n",rc);
								return XST_FAILURE;
							}


		//Se aumenta la posicion guardada de la cancion
		*CurrentBytePtr += 4;

		int byte[4];

		int i;


		for(i = 0; i < 4; i ++ ){

		//ajuste del volumen de cada muestra mediante la amplitud
		byte[i] = ReadBuffer[i];
		byte[i] = floor((byte[i] - 127)*volume);
		byte[i] = byte[i] + 127;

		//volumen minimo y maximo
		if(byte[i] < 0){
			byte[i] = 0;
		}
		else if(byte[i] >= 255){
			byte[i] = 255;
		}

		}

		//se envian las muestras al axiBuzzer
		sample  = (byte[0] << 24) | (byte[1] << 16) | (byte[2] << 8) | byte[3];

		Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4*j, sample);

//    xil_printf("sample %d\r\n", sample & 0x000000FF);
	}


}
void SdStopSong(FIL *RfPtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;
	//se cierra el archivo de audio
	rc = f_close ((FIL *)RfPtr);

	if(rc != FR_OK)
			{
				xil_printf("ERROR : f_close returned %d\r\n",rc);
				return XST_FAILURE;
			}
	//se detiene el PWM y se actualiza el estado
	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 0);
	*AudioPlayerStatePtr = STOP;
}

u32 SdChangeSong(TCHAR *filename, FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;
	//Si hay una reproduccion activa se cierra el archivo de audio
	if(*AudioPlayerStatePtr != STOP){
		rc = f_close ((FIL *)RfPtr);

		if(rc != FR_OK)
		{
			xil_printf("ERROR : f_close returned %d\r\n", rc);
			return XST_FAILURE;
		}
	}

	return SdStartSong((TCHAR *) filename, (FIL *) RfPtr, (u32 *) CurrentBytePtr, (u8 *) AudioPlayerStatePtr);

}
u32 SdSoundEffect(TCHAR *filename,  FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;

	u8 DataSizeBuff[4];
	u32 DataSize;

	if(*AudioPlayerStatePtr != 0){
		rc = f_close ((FIL *)RfPtr);

		if(rc != FR_OK)
				{
					xil_printf("ERROR : f_close returned %d\r\n",rc);
					return XST_FAILURE;
				}
	}


	rc = f_open ((FIL *)RfPtr, filename, FA_READ);

	if(rc != FR_OK)
			{
				xil_printf("ERROR : f_open returned %d\r\n",rc);
				return XST_FAILURE;
			}

	rc = f_lseek ((FIL *)RfPtr, 40);

	if(rc != FR_OK)
				{
					xil_printf("ERROR : f_lseek returned %d\r\n",rc);
					return XST_FAILURE;
				}

	rc = f_read ((FIL *)RfPtr, &DataSizeBuff, (UINT)4, &br);

	if(rc != FR_OK)
					{
						xil_printf("ERROR : f_read returned %d\r\n",rc);
						return XST_FAILURE;
					}

	// El conjunto de bytes esta en little endian, por lo que se concatenan al reves
	DataSize = (DataSizeBuff[0]) | (DataSizeBuff[1] << 8) | (DataSizeBuff[2] << 16) | (DataSizeBuff[3] << 24);

	// Las muestras de la cancion en archivos .wav empiezan a partir del byte 44
	*CurrentBytePtr = 44;

	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR + 4, 5);


	*AudioPlayerStatePtr = SOUND_EFFECT;

	return DataSize;

}
u32 SdResumeSong(TCHAR *filename,  FIL *RfPtr, u32 *CurrentBytePtr, u8 *AudioPlayerStatePtr)
{
	FRESULT rc;

	//Si hay una reproduccion se cierra el archivo actual
	if(*AudioPlayerStatePtr != STOP){
		rc = f_close ((FIL *)RfPtr);

		if(rc != FR_OK)
		{
			xil_printf("ERROR : f_close returned %d\r\n",rc);
			return XST_FAILURE;
		}
	}
	//Se abre la nueva cancion
	return SdStartSong((TCHAR *) filename, (FIL *) RfPtr, (u32 *) CurrentBytePtr, (u8 *) AudioPlayerStatePtr);

}
