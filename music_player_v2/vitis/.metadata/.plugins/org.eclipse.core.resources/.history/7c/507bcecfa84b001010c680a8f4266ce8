/***********************************************************/
void AudioTimerHandler(void *CallBackRef, u8 TmrCtrNumber)
{

	if (XTmrCtr_IsExpired(&AudioTimerInst,0)){

	    XTmrCtr_Stop(&AudioTimerInst, 0);

	    if(AudioPlayerState == 0){
	    	Xil_Out32(XPAR_AXI_BUZZER_0_S00_AXI_BASEADDR, 0);
	    }
	    else if(AudioPlayerState == 1){
	    	if(CurrentByte + 4 >= AudioSize + 44){
				CurrentByte = 44;
	    		}

			PlaySong(&Rfp, &CurrentByte);
			SongCurrentByte = CurrentByte;

	    }
	    else if(AudioPlayerState == 2){
	    	if(CurrentByte + 4 >= AudioSize + 44){
				SdResumeSong("BATTLE.wav");
				}
	    	else{
	    		PlaySong(&Rfp, &CurrentByte);
	    	}
	    }


 //Se lee la siguiente muestra del archivo de auido
//		XGpio_DiscreteWrite(&GPIO, 2, SongSample); //Se envía al bloque PWM

		XTmrCtr_Reset(&AudioTimerInst, 0);
		XTmrCtr_Start(&AudioTimerInst, 0);
	}

}

/***********************************************************/
void TmrCtrSetupIntrSystem(XTmrCtr *AudioTmrInstancePtr)
{
	XScuGic_Config *IntcConfig;

	IntcConfig = XScuGic_LookupConfig(INTC_DEVICE_ID);

	s32 status;

	status =  XScuGic_CfgInitialize(&IntcInstance, IntcConfig,
			IntcConfig -> CpuBaseAddress);

    if(status != XST_SUCCESS){
    	return -1;
    }

    Xil_ExceptionInit();// initialization of Xilinx exceptions subsystem
        // necessary before registering our Interrupt Handler

    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
    						            (Xil_ExceptionHandler)XScuGic_InterruptHandler,
    						             &IntcInstance);
    Xil_ExceptionEnable();


    XTmrCtr_SetHandler(&AudioTimerInst, (XTmrCtr_Handler)AudioTimerHandler, &AudioTimerInst);
  	XTmrCtr_SetResetValue(&AudioTimerInst, TIMER_CNTR_AUDIO, AUDIO_RESET_VALUE);
  	XTmrCtr_SetOptions(&AudioTimerInst, TIMER_CNTR_AUDIO, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);
   	XTmrCtr_Start(&AudioTimerInst, TIMER_CNTR_AUDIO);

    XScuGic_SetPriorityTriggerType(&IntcInstance, TMRCTR_AUDIO_INTERRUPT_ID,
        		 0x18, 0x01);

    status = XScuGic_Connect(&IntcInstance, TMRCTR_AUDIO_INTERRUPT_ID,
        		(Xil_ExceptionHandler)AudioTimerHandler, (void *) AudioTmrInstancePtr);


	if(status != XST_SUCCESS){
	    	return -1;
	    }

	XScuGic_Enable(&IntcInstance, TMRCTR_AUDIO_INTERRUPT_ID);



} // enables exception management

