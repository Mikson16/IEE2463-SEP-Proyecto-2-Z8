static unsigned main_song_sample;
void SdPlayer(u8 SONG_ID)
{   FRESULT rc;
    FIL Rfp;
    u8 ReadBuffer[2];
    UINT *br;
    TCHAR song_path;
    UINT &br;

    if(SONG_ID == 1){
    	song_path = "0:/battle_music.bin";
    }
    else{
    	return;
    }

	rc = f_open (&Rfp, song_path, 1);

	if(rc != FR_OK)
		    {
		        xil_printf("ERROR : f_mount returned %d\r\n",rc);
		        return XST_FAILURE;
		    }

	rc = f_lseek (&Rfp, 0);

	if(rc != FR_OK)
			    {
			        xil_printf("ERROR : f_mount returned %d\r\n",rc);
			        return XST_FAILURE;
			    }

	rc = f_read (&Rfp, &ReadBuffer, (UINT)2, (UNIT*)br);

	if(rc != FR_OK)
				    {
				        xil_printf("ERROR : f_mount returned %d\r\n",rc);
				        return XST_FAILURE;
				    }
	xil_printf("%c %c", ReadBuffer[0], ReadBuffer[1]);
}
