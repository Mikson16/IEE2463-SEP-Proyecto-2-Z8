int InterruptSetUp(XTmrCtr *InputTmrInstancePtr, XTmrCtr *AudioTmrInstancePtr, XGpio *LightGpioInstancePtr, XGpio *BtnGpioInstancePtr)
{
	XScuGic_Config *IntcConfig;

		IntcConfig = XScuGic_LookupConfig(INTC_DEVICE_ID);

		s32 status;

		status =  XScuGic_CfgInitialize(&IntcInstance, IntcConfig,
				IntcConfig -> CpuBaseAddress);

	    if(status != XST_SUCCESS){
	    	return -1;
	    }

	    XGpio_InterruptEnable(&gpioLight, LIGHT_INT_CH);
	    XGpio_InterruptGlobalEnable(&gpioLight);

	    XGpio_InterruptEnable(&gpioBtn, BTN_INT_CH);
	    XGpio_InterruptGlobalEnable(&gpioBtn);

	    Xil_ExceptionInit();// initialization of Xilinx exceptions subsystem
	        // necessary before registering our Interrupt Handler

	    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
	    						            (Xil_ExceptionHandler)XScuGic_InterruptHandler,
	    						             &IntcInstance);
	    Xil_ExceptionEnable();


	    XTmrCtr_SetHandler(&InputTimerInst, (XTmrCtr_Handler)readInputs, &InputTimerInst);
	  	XTmrCtr_SetResetValue(&InputTimerInst, TIMER_CNTR_INPUT, INPUT_RESET_VALUE);
	  	XTmrCtr_SetOptions(&InputTimerInst, TIMER_CNTR_INPUT, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);

	  	XTmrCtr_SetHandler(&AudioTimerInst, (XTmrCtr_Handler)AudioTimerHandler, &AudioTimerInst);
		XTmrCtr_SetResetValue(&AudioTimerInst, TIMER_CNTR_AUDIO, AUDIO_RESET_VALUE);
		XTmrCtr_SetOptions(&AudioTimerInst, TIMER_CNTR_AUDIO, XTC_INT_MODE_OPTION | XTC_AUTO_RELOAD_OPTION);


	    XScuGic_SetPriorityTriggerType(&IntcInstance, INPUT_TMRCTR_INTERRUPT_ID,
	        		 0x18, 0x01);
	    XScuGic_SetPriorityTriggerType(&IntcInstance, GPIO_LIGHT_INTERRUPT_ID,
					 0x20, 0x03);
	    XScuGic_SetPriorityTriggerType(&IntcInstance, GPIO_BTN_INTERRUPT_ID,
					 0x28, 0x03);
	    XScuGic_SetPriorityTriggerType(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID,
					 0x30, 0x01);

	    status = XScuGic_Connect(&IntcInstance, INPUT_TMRCTR_INTERRUPT_ID,
	        		(Xil_ExceptionHandler)readInputs, (void *) InputTmrInstancePtr);

		if(status != XST_SUCCESS){
		    	return -1;
		    }

		status = XScuGic_Connect(&IntcInstance, GPIO_LIGHT_INTERRUPT_ID,
					(Xil_ExceptionHandler)lightHandler, (void *) LightGpioInstancePtr);

		if(status != XST_SUCCESS){
				return -1;
			}

		status = XScuGic_Connect(&IntcInstance, GPIO_BTN_INTERRUPT_ID,
					(Xil_ExceptionHandler)btnHandler, (void *) BtnGpioInstancePtr);

		if(status != XST_SUCCESS){
				return -1;
			}

		status = XScuGic_Connect(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID,
					(Xil_ExceptionHandler)AudioTimerHandler, (void *) AudioTmrInstancePtr);


		if(status != XST_SUCCESS){
				return -1;
			}


		XScuGic_Enable(&IntcInstance, INPUT_TMRCTR_INTERRUPT_ID);
		XScuGic_Enable(&IntcInstance, AUDIO_TMRCTR_INTERRUPT_ID);
		XScuGic_Enable(&IntcInstance, GPIO_LIGHT_INTERRUPT_ID);
		XScuGic_Enable(&IntcInstance, GPIO_BTN_INTERRUPT_ID);
		XTmrCtr_Start(&InputTimerInst, TIMER_CNTR_INPUT);
		XTmrCtr_Start(&AudioTimerInst, TIMER_CNTR_AUDIO);
		return 0;
}
